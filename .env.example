# Application identity and runtime mode
APP_NAME=OpenAI AI Platform
ENVIRONMENT=development
PORT=8000

# OpenAI (required for live agent requests; never commit a real key)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2

# Authentication (required; generate a unique random value of at least 32 characters)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# PostgreSQL and SQLAlchemy
DATABASE_URL=postgresql+asyncpg://platform:change-me@localhost:5432/platform
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis cache and distributed rate limiter
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300
CACHE_KEY_VERSION=infra-agents-v2
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REQUESTS=30

# Agent execution bounds
AGENT_MAX_TURNS=6
AGENT_TIMEOUT_SECONDS=90

# Comma-separated browser origins allowed by CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# OpenTelemetry. Leave the endpoint empty to keep instrumentation local only.
OTEL_SERVICE_NAME=openai-ai-platform
OTEL_EXPORTER_OTLP_ENDPOINT=
